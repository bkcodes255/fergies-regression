# Data (raw pulls and derived data are local-only; schema/dictionary in sql/ and data/ root are
# tracked. data/historical/ IS tracked despite being "derived" - it's what the deployed
# dashboard's Model Lab tab needs at runtime, and every file in it is under GitHub's 10MB
# Git LFS threshold, so plain git is fine)
data/raw/**
data/processed/**
data/injuries/**
data/injury_unmatched_report.csv
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/injuries/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
venv/

# Env / secrets
.env
.env.local
!.env.example

# Notebooks checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
*.joblib
