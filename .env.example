DATABASE_URL=postgresql://fergies_app:CHANGE_ME@localhost:5432/fergies_regression
FPL_SEASON=2026-27
FPL_ENTRY_ID=your_fpl_entry_id_here

# Only needed for src/fpl_write (eventual auto-submit). The programmatic email/password login
# flow no longer works - users.premierleague.com doesn't resolve anymore (confirmed 2026-08-26).
# FPL_EMAIL/FPL_PASSWORD are kept here in case that flow comes back some day.
#
# The working path is manual credential handoff from a real browser session: log into
# fantasy.premierleague.com, F12 -> Network tab -> Fetch/XHR filter -> click the request to
# https://fantasy.premierleague.com/api/me/ -> Headers -> Request Headers. Copy TWO values:
#   - x-api-authorization  -> FPL_API_AUTHORIZATION (the real auth credential - required)
#   - cookie               -> FPL_SESSION_COOKIE (sent alongside, may matter for CSRF/bot-
#                              protection checks - optional but include it if present)
# Both expire periodically - re-copy when requests start failing. Never commit real values -
# .env is gitignored, this file isn't.
FPL_EMAIL=your_fpl_login_email_here
FPL_PASSWORD=your_fpl_password_here
FPL_SESSION_COOKIE=your_extracted_browser_cookie_header_here
FPL_API_AUTHORIZATION=your_extracted_x-api-authorization_header_here

# Only needed for src/notify (Telegram bot). Create a bot by messaging @BotFather in Telegram
# ("/newbot", follow the prompts) - it gives you a token immediately, no approval process.
# TELEGRAM_CHAT_ID: leave blank at first: run `python -m src.notify.telegram_bot`, send your
# new bot any message, and it'll print the chat_id to fill in here.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather_here
TELEGRAM_CHAT_ID=

# Only needed for scripts/scrape_crests_to_supabase.py. Get these from the Supabase dashboard:
# Project Settings -> API. SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security - it's what
# lets the script write into the private team-crests bucket, so treat it like a password and
# never commit a real value. SUPABASE_CRESTS_BUCKET defaults to "team-crests" (already created
# as a private bucket in the fergies-regression Supabase project) if left blank.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_CRESTS_BUCKET=team-crests
